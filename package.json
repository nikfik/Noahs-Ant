{
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.18.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  },
  "name": "noahs-ant",
  "version": "1.0.0",
  "description": "",
  "main": "public/scripts/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "env-paths": "^3.0.0",
    "ffmpeg-static": "^5.3.0",
    "graceful-fs": "^4.2.11",
    "ms": "^2.1.3",
    "progress": "^2.0.3",
    "semver": "^7.8.5",
    "sumchecker": "^3.0.1",
    "undici": "^7.28.0",
    "undici-types": "^7.18.2",
    "xlsx": "^0.18.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikfik/Noahs-Ant.git"
  },
  "keywords": [],
  "author": "Noah’s Ant",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nikfik/Noahs-Ant/issues"
  },
  "homepage": "https://github.com/nikfik/Noahs-Ant#readme",
  "build": {
    "appId": "pl.noahsant.app",
    "productName": "Noah’s Ant",
    "artifactName": "NoahsAnt-${version}-portable.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "package.json",
      "!public/assets/anticon.png"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/anticon.png",
      "signExecutable": false
    }
  }
}
